/* See the wiki for examples and details: https://github.com/dani-garcia/vaultwarden/wiki/Customize-Vaultwarden-CSS */

/**** START Identidade visual PAR Participações ****/
$par-blue: #1d469b;
$par-blue-dark: #163675;
$par-blue-light: #6b8fd6;
$logo-default: url("../vw_static/logo-white.png");
$logo-login: url("../vw_static/logo-gray.png");
$icon-collapsed: url("../vw_static/par-icon-white.png");

$system-name: "VF Guard";
$no-share-login: "Atenção: suas credenciais são pessoais e intransferíveis. Nunca compartilhe sua senha mestra nem as senhas guardadas no VF Guard, nem mesmo com colegas ou com a equipe de TI. A PAR Participações jamais solicitará sua senha.";
$no-share-app: "Senhas são pessoais e intransferíveis. Nunca as compartilhe.";

/* Paleta de cores (tema claro) */
:root {
  --color-brand-050: #eef3fb;
  --color-brand-100: #dce6f6;
  --color-brand-200: #b9cdec;
  --color-brand-300: #8eaee0;
  --color-brand-400: #5f88cf;
  --color-brand-500: #3a69bd;
  --color-brand-600: #2753a8;
  --color-brand-700: #1d469b;
  --color-brand-800: #183a82;
  --color-brand-900: #132e66;
  --color-brand-950: #0d1f45;

  --color-primary-100: 220 230 246;
  --color-primary-600: 29 70 155;
  --color-primary-700: 22 54 117;

  --color-nav-bg-primary: #{$par-blue};
  --color-nav-bg-primary-strong: #{$par-blue-dark};
}

/* Paleta de cores (tema escuro) */
.theme_dark {
  --color-primary-100: 19 46 102;
  --color-primary-600: 107 143 214;
  --color-primary-700: 185 205 236;

  --color-nav-bg-primary: #0d1f45;
  --color-nav-bg-primary-strong: #132e66;
}

/* Logo na tela de login */
auth-anon-layout bit-landing-header bit-svg {
  flex-direction: column;
  align-items: flex-start;
  > svg {
    @extend %vw-hide;
  }
  &::before {
    content: "";
    display: block;
    flex-shrink: 0;
    width: 152px;
    height: 56px;
    background: $logo-login no-repeat center left / contain;
  }
  &::after {
    content: $system-name;
    display: block;
    margin-top: 0.5rem;
    color: $par-blue;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
}
.theme_dark auth-anon-layout bit-landing-header bit-svg::after {
  color: $par-blue-light;
}

/* Logo na barra lateral */
bit-nav-logo bit-svg {
  > svg {
    @extend %vw-hide;
  }
  &::before {
    content: "";
    display: block;
    width: 100%;
    height: 56px;
    background: $logo-default no-repeat center left / auto 48px;
  }
}

/* Barra lateral recolhida (sem largura fixa no style): mostra apenas o símbolo */
#bit-side-nav:not([style*="width"]) bit-nav-logo bit-svg::before {
  width: 26px;
  height: 26px;
  background: $icon-collapsed no-repeat center / contain;
}

/* Aviso de não compartilhamento de senhas: tela de login */
auth-anon-layout bit-landing-footer footer::before {
  content: $no-share-login;
  display: block;
  max-width: 36rem;
  margin: 0 auto 1rem;
  padding: 0.75rem 1rem;
  border-left: 4px solid $par-blue;
  border-radius: 0.25rem;
  background: var(--color-brand-050);
  color: var(--color-brand-950);
  font-size: 0.875rem;
  line-height: 1.4;
  text-align: left;
}
.theme_dark auth-anon-layout bit-landing-footer footer::before {
  border-left-color: $par-blue-light;
  background: var(--color-brand-950);
  color: var(--color-brand-100);
}

/* Aviso de não compartilhamento de senhas: rodapé da barra lateral */
#bit-side-nav::after {
  content: $no-share-app;
  display: block;
  /* Não deixa o texto ditar a largura da barra lateral */
  width: 0;
  min-width: 100%;
  box-sizing: border-box;
  padding: 0.75rem 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.85);
  font-size: 0.75rem;
  line-height: 1.3;
}
#bit-side-nav:not([style*="width"])::after {
  @extend %vw-hide;
}
/**** END Identidade visual PAR Participações ****/
